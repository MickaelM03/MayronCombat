# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AIzaSyA4CAr2zW7yLD8bC9AizA0ZYrVbeF4-qVQ"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Optional. Set this to enable cloned-voice TTS via ElevenLabs.
# - Inscription : https://elevenlabs.io (compte gratuit)
# - Settings → API Keys → Create API Key
# - Free tier : 10 000 chars/mois, 10 voix clonées max
# - Mappe ensuite chaque perso vers son voiceId dans scripts/elevenlabs_voices.json
# - Si non défini, le fallback XTTS / Piper / Web Speech reste actif
ELEVENLABS_API_KEY="1cabc1c6124742eb8a0f7741e0437b8b"

# GOOGLE_CLOUD_TTS_API_KEY: Optional. Active Google Cloud Text-to-Speech (Neural2 / WaveNet / Studio).
# - Clé SÉPARÉE de Gemini (Google Cloud Console → APIs & Services → Credentials → Create API key)
# - Activer "Cloud Text-to-Speech API" sur le projet
# - Free tier : 1M caractères/mois en Neural2 (largement suffisant)
# - Voix FR : fr-FR-Neural2-A à E, fr-FR-Wavenet-A à E, fr-FR-Studio-A/D
GOOGLE_CLOUD_TTS_API_KEY=""

# HUGGINGFACE_API_KEY: Optional. Active TTS via Hugging Face Inference API.
# - https://huggingface.co/settings/tokens (token "read" suffit)
# - Gratuit mais rate-limité ; premier appel = cold-start (~10-30s)
HUGGINGFACE_API_KEY=""

# HF_TTS_MODEL: Modèle HF utilisé. Défaut : facebook/mms-tts-fra (Meta MMS, français).
# Autres options testées : coqui/XTTS-v2 (lourd), elevenlabs/eleven-multilingual-v1 (payant).
HF_TTS_MODEL="facebook/mms-tts-fra"
